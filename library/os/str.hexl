#include std::"os/mem.hexl"
#include std::"lib.hexl"

// Hexl string library.
// Build with --linux or --windows so mem.hexl selects one backend.
//
// ■ 使い方
//   s := Str::new("hello")         // 使い終わったら必ず del (must=del)
//   s.push(33)                     // '!'
//   s.push_str(" world")
//   s.start_with("he")             // 1
//   s.end_with("d!")               // 1
//   s.len()                        // 12
//   r := s.pop()                   // lib::Option<byte>: 空なら None
//   s.del()
//
// ■ 仕様
//   - 中身は NUL 終端しない。長さは len() で持つ。
//   - init_msg / end_txt / start_txt / str は NUL 終端のバイト列。
//   - メモリ確保に失敗したら buf は 0、len=0、cap=0 になる(以降の push は
//     再確保を試みる)。
//   - 値が無い(空の pop)は std の lib::Option で返す。

// ---------------------------------------------------------------
// 内部ヘルパ(OS非依存の x86-64 asm)
// Windows x64 では rsi/rdi が呼び出し先保存レジスタなので push/pop で守る。
// ---------------------------------------------------------------

// src から dst へ n バイトコピーする。n が 0 以下なら何もしない。
os_copy(dst: i64, src: i64, n: i64) {
    cond n > 0 {
        #asm(gcc_x64) {
            "movq ${dst + 0}, %rax"
            "movq ${src + 0}, %rdx"
            "movq ${n}, %rcx"
            "pushq %rsi"
            "pushq %rdi"
            "movq %rax, %rdi"
            "movq %rdx, %rsi"
            "cld"
            "rep movsb"
            "popq %rdi"
            "popq %rsi"
        }
    }
}

// NUL 終端バイト列 addr の長さ(NUL は含まない)。addr が 0 なら 0。
os_strlen(addr: i64): i64 {
    cond addr == 0 {
        ret 0
    }
    res: i64 = 0
    #asm(gcc_x64) {
        "movq ${addr + 0}, %rdx"
        "movq $-1, %rcx"
        "xorq %rax, %rax"
        "pushq %rdi"
        "movq %rdx, %rdi"
        "cld"
        // al(=0) と一致するまで進む。rcx は -1 から減っていく。
        "repne scasb"
        "popq %rdi"
        // 長さ = (-1 - rcx) - 1 = ~rcx - 1
        "notq %rcx"
        "subq $1, %rcx"
        "movq %rcx, ${res}"
    }
    ret res
}

// a と b の先頭 n バイトが等しければ 1、違えば 0。n が 0 以下なら 1。
os_equal(a: i64, b: i64, n: i64): i64 {
    cond n <= 0 {
        ret 1
    }
    res: i64 = 0
    #asm(gcc_x64) {
        "movq ${a + 0}, %rax"
        "movq ${b + 0}, %rdx"
        "movq ${n}, %rcx"
        "pushq %rsi"
        "pushq %rdi"
        "movq %rax, %rsi"
        "movq %rdx, %rdi"
        "cld"
        // 全部一致なら最後に ZF=1
        "repe cmpsb"
        "sete %al"
        "popq %rdi"
        "popq %rsi"
        "movzbq %al, %rax"
        "movq %rax, ${res}"
    }
    ret res
}


// Hexl format library.
//
// C言語の printf 風の書式で、1つの値を buf へ書き込む。
//
//   pub format<T>(buf: byte*"unlimit", fmt: byte*"unlimit", arg: T): byte*"unlimit"
//
// - fmt を buf へコピーしながら、最初の変換指定(%d など)を arg で置き換える
// - buf の末尾に 0(NUL)を書き、その NUL の位置のポインタを返す
//   (戻り値を次の format の buf に渡すと、続けて書き足せる)
// - hexl には可変長引数が無いので、1回の呼び出しで置き換える変換指定は1つだけ。
//   2つ目以降の変換指定(%% 以外)は、そのまま文字として出力する
// - buf には、出力が入る大きさ(NUL を含む)を呼び出し側が用意すること
//
// 対応する書式: %[フラグ][幅][長さ]変換
//   フラグ : '-'(左寄せ) '0'(0埋め)
//   幅     : 10進数
//   長さ   : l h z は読み飛ばす(整数は常に64bitで扱う)
//   変換   : d i  符号付き10進数      u  符号なし10進数
//            x X  16進数(小文字/大文字)  o  8進数   b  2進数
//            c    1文字              s  NUL終端の文字列(arg は先頭アドレス。0なら "(null)")
//            p    "0x" + 16進数      %  '%' そのもの(arg は使わない)
//
// 使い方:
//   p: byte*"unlimit" = format<i64>(buf, "n=%d ", 42)
//   p = format<byte*>(p, "name=%s", "abc")
//
// 注意: 添字アクセスは Vec と同じ `[ptr idx else 0]` の形を使う。
//       添字の式は、先に変数へ計算してから渡している。

// v を base 進数で buf[pos..] に書く。書いた文字数を返す(0 でも "0" を1文字書く)。
// upper が 1 のとき、a-f を大文字にする。
fmt_utoa(buf mut: byte*"unlimit", pos: u64, v: u64, base: u64, upper: u64): u64 {
    n mut: u64 = 0
    x mut: u64 = v
    // 下の桁から順に書く(あとで逆順に直す)
    loop {
        d: u64 = x % base
        dc mut: u64 = 0x30 + d
        cond d >= 10 {
            cond upper == 1 {
                dc = 0x37 + d
            } else {
                dc = 0x57 + d
            }
        }
        ip: u64 = pos + n
        [buf ip else 0] = dc
        n = n + 1
        x = x / base
        cond x == 0 {
            break
        }
    }

    // 書いた桁を逆順に並べ直す
    lo mut: u64 = 0
    hi mut: u64 = n - 1
    loop {
        cond lo >= hi {
            break
        }
        il: u64 = pos + lo
        ih: u64 = pos + hi
        a: byte = [buf il else 0]
        b: byte = [buf ih else 0]
        [buf il else 0] = b
        [buf ih else 0] = a
        lo = lo + 1
        hi = hi - 1
    }
    ret n
}

// buf[pos..pos+n] に書いた文字列を、幅 width に合わせて埋める。埋めた後の文字数を返す。
// sg は先頭の符号("-" や "0x")の文字数。0埋めのときは、符号の後ろに 0 を入れる。
// left が 1 のとき左寄せ(右側を空白で埋める)。
fmt_pad(buf mut: byte*"unlimit", pos: u64, n: u64, sg: u64, width: u64, left: u64, zero: u64): u64 {
    cond width <= n {
        ret n
    }
    pad: u64 = width - n

    // 左寄せ: 右側を空白で埋める
    cond left == 1 {
        k mut: u64 = 0
        loop {
            cond k >= pad {
                break
            }
            ip: u64 = pos + n + k
            [buf ip else 0] = 0x20
            k = k + 1
        }
        ret width
    }

    // 右寄せ: 埋める位置(start)から後ろの文字を pad 文字ぶん右へずらして、空いた所を埋める
    start mut: u64 = pos
    fill mut: u64 = 0x20
    cond zero == 1 {
        start = pos + sg
        fill = 0x30
    }
    j mut: u64 = pos + n
    loop {
        cond j <= start {
            break
        }
        j = j - 1
        dst: u64 = j + pad
        c: byte = [buf j else 0]
        [buf dst else 0] = c
    }
    m mut: u64 = 0
    loop {
        cond m >= pad {
            break
        }
        ip: u64 = start + m
        [buf ip else 0] = fill
        m = m + 1
    }
    ret width
}

// "(null)" を buf[pos..] に書く。書いた文字数(6)を返す。
fmt_null(buf mut: byte*"unlimit", pos: u64): u64 {
    p0: u64 = pos
    p1: u64 = pos + 1
    p2: u64 = pos + 2
    p3: u64 = pos + 3
    p4: u64 = pos + 4
    p5: u64 = pos + 5
    [buf p0 else 0] = 0x28
    [buf p1 else 0] = 0x6E
    [buf p2 else 0] = 0x75
    [buf p3 else 0] = 0x6C
    [buf p4 else 0] = 0x6C
    [buf p5 else 0] = 0x29
    ret 6
}

// 文字列 fmt を buf へ書式化する。詳しくはファイル先頭の説明を参照。
pub format<T>(buf mut: byte*"unlimit", fmt: byte*"unlimit", arg: T): byte*"unlimit" {
    a: i64 = arg
    o mut: u64 = 0
    i mut: u64 = 0
    // 値を置き換える変換指定を、すでに1つ使ったか(0/1)
    used mut: u64 = 0

    loop {
        c: byte = [fmt i else 0]
        cond c == 0 {
            break
        }
        cond c != 0x25 {
            // 普通の文字はそのままコピー
            [buf o else 0] = c
            o = o + 1
            i = i + 1
        } else {
            // '%' の次から変換指定を読む
            i = i + 1

            // フラグ: '-' と '0'
            left mut: u64 = 0
            zero mut: u64 = 0
            loop {
                f: byte = [fmt i else 0]
                cond {
                    f == 0x2D => {
                        left = 1
                        i = i + 1
                    }
                    f == 0x30 => {
                        zero = 1
                        i = i + 1
                    }
                    else => {
                        break
                    }
                }
            }

            // 幅
            width mut: u64 = 0
            loop {
                w: byte = [fmt i else 0]
                cond w >= 0x30 && w <= 0x39 {
                    wd: u64 = w
                    width = width * 10 + (wd - 0x30)
                    i = i + 1
                } else {
                    break
                }
            }

            // 長さ(l h z)は読み飛ばす
            loop {
                m: byte = [fmt i else 0]
                cond m == 0x6C || m == 0x68 || m == 0x7A {
                    i = i + 1
                } else {
                    break
                }
            }

            // 変換の種類
            t: byte = [fmt i else 0]
            cond t == 0 {
                // "%" で文字列が終わっている
                break
            }
            i = i + 1

            cond t == 0x25 {
                // %%
                [buf o else 0] = 0x25
                o = o + 1
            } else {
                cond used == 1 {
                    // 2つ目以降の変換指定は、そのまま出力する
                    o1: u64 = o + 1
                    [buf o else 0] = 0x25
                    [buf o1 else 0] = t
                    o = o + 2
                } else {
                    used = 1
                    n mut: u64 = 0
                    sg mut: u64 = 0
                    cond {
                        t == 0x64 || t == 0x69 => {
                            // %d %i
                            mag mut: u64 = (u64)a
                            cond a < 0 {
                                [buf o else 0] = 0x2D
                                sg = 1
                                mag = 0 - a
                            }
                            os: u64 = o + sg
                            n = sg + fmt_utoa(buf, os, mag, 10, 0)
                        }
                        t == 0x75 => {
                            n = fmt_utoa(buf, o, (u64)a, 10, 0)
                        }
                        t == 0x78 => {
                            n = fmt_utoa(buf, o, (u64)a, 16, 0)
                        }
                        t == 0x58 => {
                            n = fmt_utoa(buf, o, (u64)a, 16, 1)
                        }
                        t == 0x6F => {
                            n = fmt_utoa(buf, o, (u64)a, 8, 0)
                        }
                        t == 0x62 => {
                            n = fmt_utoa(buf, o, (u64)a, 2, 0)
                        }
                        t == 0x70 => {
                            // %p: "0x" + 16進数
                            o1: u64 = o + 1
                            o2: u64 = o + 2
                            [buf o else 0] = 0x30
                            [buf o1 else 0] = 0x78
                            sg = 2
                            n = 2 + fmt_utoa(buf, o2, (u64)a, 16, 0)
                        }
                        t == 0x63 => {
                            // %c
                            [buf o else 0] = a
                            n = 1
                            zero = 0
                        }
                        t == 0x73 => {
                            // %s: arg は文字列の先頭アドレス
                            zero = 0
                            cond a == 0 {
                                n = fmt_null(buf, o)
                            } else {
                                sp: byte*"unlimit" = a
                                k mut: u64 = 0
                                loop {
                                    ch: byte = [sp k else 0]
                                    cond ch == 0 {
                                        break
                                    }
                                    ik: u64 = o + k
                                    [buf ik else 0] = ch
                                    k = k + 1
                                }
                                n = k
                            }
                        }
                        else => {
                            // 知らない変換は '%' と文字をそのまま出力し、値は使わない
                            o1: u64 = o + 1
                            [buf o else 0] = 0x25
                            [buf o1 else 0] = t
                            n = 2
                            used = 0
                            zero = 0
                        }
                    }
                    o = o + fmt_pad(buf, o, n, sg, width, left, zero)
                }
            }
        }
    }

    // 終端
    [buf o else 0] = 0
    ret buf + o
}


// ---------------------------------------------------------------
// Str
// ---------------------------------------------------------------
pub struct Str {
    pub buf: byte*"unlimit" must=free
    len: u64
    cap: u64

    // init_msg を複製して作る。使い終わったら del を呼ぶこと。
    pub new(init_msg: byte*): Self must=del {
        src: i64 = init_msg
        n: u64 = os_strlen(src)
        c mut: u64 = n * 2
        cond c < 16 {
            c = 16
        }
        s := Self {
            buf: mem::malloc<byte>(c)
            len: 0
            cap: c
        }
        a: i64 = s.buf
        cond a == 0 {
            s.cap = 0
        } else {
            os_copy(a, src, n)
            s.len = n
        }
        ret s
    }

    pub del(self: Self*of new) {
        mem::free<byte>(self->buf)
    }

    // 末尾に1バイト追加する。再確保に失敗したら何もしない。
    pub push(self mut: Self*, chr: byte) {
        ok: u64 = reserve(self, self->len + 1)
        cond ok == 1 {
            l: u64 = self->len
            [self->buf l else 0] = chr
            self->len += 1
        }
    }

    // 末尾の1バイトを取り出す。空なら None。
    pub pop(self mut: Self*): lib::Option<byte> {
        cond self->len >= 1 {
            self->len -= 1
            l: u64 = self->len
            r: byte = [self->buf l else 0]
            v := lib::Option<byte>::Some(r)
            ret v
        } else {
            ret lib::Option<byte>::None
        }
    }

    // 末尾が end_txt と一致すれば 1。空文字列は常に 1。
    pub end_with(self: Self*, end_txt: byte*): bool {
        e: i64 = end_txt
        m: u64 = os_strlen(e)
        cond m > self->len {
            ret 0
        }
        base: i64 = self->buf
        from: i64 = base + self->len - m
        r: i64 = os_equal(from, e, m)
        cond r == 1 {
            ret 1
        }
        ret 0
    }

    // 先頭が start_txt と一致すれば 1。空文字列は常に 1。
    pub start_with(self: Self*, start_txt: byte*): bool {
        s: i64 = start_txt
        m: u64 = os_strlen(s)
        cond m > self->len {
            ret 0
        }
        base: i64 = self->buf
        r: i64 = os_equal(base, s, m)
        cond r == 1 {
            ret 1
        }
        ret 0
    }

    // 末尾に str(NUL 終端)を追加する。再確保に失敗したら何もしない。
    pub push_str(self mut: Self*, str: byte*) {
        src: i64 = str
        m: u64 = os_strlen(src)
        cond m > 0 {
            ok: u64 = reserve(self, self->len + m)
            cond ok == 1 {
                base: i64 = self->buf
                dst: i64 = base + self->len
                os_copy(dst, src, m)
                self->len += m
            }
        }
    }

    pub len(self: Self*): u64 {
        ret self->len
    }

    // 容量を倍にする(0 のときは 16)。失敗したら 0 を返し、buf は空になる。
    realloc(self mut: Self*): bool {
        newcap: u64 = self->cap * 2
        cond newcap < 16 {
            newcap = 16
        }
        self->buf = mem::realloc<byte>(self->buf, newcap)
        p: i64 = self->buf
        cond p == 0 {
            self->len = 0
            self->cap = 0
            ret 0
        }
        self->cap = newcap
        ret 1
    }

    pub del(self: Self* of new) {
        mem::free<byte>(self->buf)
    }
}

// need バイト入るまで realloc を繰り返す。入れば 1、失敗なら 0。
// (realloc は倍々なので再帰の深さは対数)
reserve(s: Str*, need: u64): u64 {
    cond s->cap >= need {
        ret 1
    }
    ok: bool = s->realloc()
    cond ok == 1 {
        ret reserve(s, need)
    }
    ret 0
}


