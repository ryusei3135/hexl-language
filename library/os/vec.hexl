#include "library/os/mem.hexl"


pub struct Vec<T> {
    val: T*"unlimit" must=free
    len: u64
    cap: u64

    pub new(): Self {
        ret Self {
            val: mem::malloc<T>(10)
            len: 0
            cap: 10
        }
    }

    pub push(self mut: Self*, val: T) {
        l: u64 = self->len
        cond l > self->cap {
            self->cap += 10
            self->val = mem::realloc<T>(self->val, self->cap)
        }
        [self->val l else 0] = val
        self->len++
    }

    pub del(self: Self*) {
        mem::free<T>(self->val)
    }
}
