#include "library/os/mem.hexl"


pub struct Vec<T> {
    val: T* must=free
    len: u64
    cap: u64

    pub new(): Self {
        ret Self {
            val: mem::malloc<T>(10)
            len: 0
            cap: 10
        }
    }

    pub push(self: Self*, val: T) {
        l: u64 = self->len
        // `[` の直後は変数名のみ。`[self->val l]` は書けないので、一度ローカル変数に入れる
        p: T* must=free = self->val
        [p l] = val
        self->len = l + 1
    }

    pub del(self: Self*) {
        mem::free<T>(self->val)
    }
}
