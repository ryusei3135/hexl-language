


add(a: b4, b: b4): b4 {
    a = a + 100
    c: b4 = b + a
    c = a + 2
    ret c
}

_start(a: a, b: b): b1 {
    c: b1 = "hello world"
    match {
        10 < 1 {
            add(10, 1)
        }
        | {
            add(3, 3)
        }
    }
    #x64 {
        "mov eax, 1"
        "mov edi, 1"
        "lea esi, ${c}"
        "mov edx, 10"
        "syscall"
    }
}
