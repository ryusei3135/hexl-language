#include io="library/os/io.hexl"
#include "t.c"
#include "library/os/mem.hexl"


#define M(expr) {{
    expr = 10
    expr += 3
}}

struct Name {
    name: int
    aa: int

    f(self mut: Self) {
        self.name = 0
    }
}

impl Name {
    fn(self: Self) {
        self.name
    }
}

variant E {
    a
    b(int)
    c
}

variant Option<T> {
    Some(T)
    None
}

variant Result<T, E> {
    Ok(T)
    Err(E)
}

variant"unsafe" UnsafeV {
    name: int
    name2: i64
}

f<T>(): T {
    e mut: E = E::b(10)
    cond E::b(val) mut:= e {
        val += 1
    } else {
        a: int = 10
    }
    lll: T = T {
        name: 10
        aa: 10
    }
    e = E::c
    ret lll
}


func4(): int must=func5 {
    jjj: UnsafeV = UnsafeV::name {
        name: 1
    }
    ret 10
}

func5(a: int of func4): Result<int, byte> {
    name mut: int = 10
    #M(name)
    ret Result::Ok(a + 10)
}

func6(a: int must=func5, f: float) {
    r: Result<int, int> = Result<int, int>::Ok(10)
    cond Result::Ok(v) := r {
        c: int = 0
    } else {
        b: int = 0
    }
    func5(a)
}


add(a mut: int, b: int): Option<int> {
    t::c_func()
    c: byte* = "hello world\n"
    d: byte* = "tomato\n"

    loop a > 0 {
        cond {
            a > 5 => {
                io::print_line(c, 12)
            }
            else => {
                io::print_line(d, 8)
                break
            }
        }
        a--
    }
    ret Option::None
}

test_arr(idx: uint): i64 {
    ptr: int* must=free = mem::malloc<int>(10)
    arr: [int 5] = {0}
    var: int = [arr idx else 0]
    mem::free<int>(ptr)
    ret (i64)var
}

_start(): int {
    fv: float = 1.1
    f2: float = 2.1
    fv3: float = fv + f2
    arr2 mut: [uint 3] = {0}
    [arr2 0] = 2
    calcul mut: int = 10
    calcul = calcul << 3 & 10
    o: Option<int> = Option::Some(10)
    h: int must=func5 = func4()
    a: static[int] = 30
    ptr mut: int* = [a]
    [arr2 2] = 10
    s: Name* = Name {
        name: 10
        aa: 10
    }
    u: u64 = sizeof(int)
    func6(h, 2.3)
    add(s.name, a)
    add(a, 0)
    test_arr(1)
    #asm(gcc_x64) {
        "{space}movl $60, %eax"
        "{space}movl $0, %edi"
        "{space}syscall"
    }
    ll: Name = f<Name>()
    ret 0
}
