#include test::b


struct Name {
    name: int
}


add(a: int, b: int): int {
    c: char = "hello world\n"
    d: char = "tomato"
    b::add_1(10)
    loop a > 0 {
        match {
            a > 5 {
                #asm(gcc_x64) {
                    "{space}mov $1, %eax"
                    "{space}mov $1, %edi"
                    "{space}lea ${c}(%rip), %rsi"
                    "{space}mov $12, %edx"
                    "{space}syscall"
                }
            }
            | {
                #asm(gcc_x64) {
                    "{space}mov $1, %eax"
                    "{space}mov $1, %edi"
                    "{space}lea ${d}(%rip), %rsi"
                    "{space}mov $10, %edx"
                    "{space}syscall"
                }
            }
        }
        a = a - 1
    }
    ret b
}

_start(): int {
    add(10, 1)
    #asm(gcc_x64) {
        "{space}mov $0, %eax"
        "{space}mov $60, %edi"
        "{space}syscall"
    }
    ret 0
}
