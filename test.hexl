#include test::b


struct Name {
    name: int
}


add(a: int, b: int) {
    c: byte = "hello world\n"
    d: byte = "tomato\n"

    loop a > 0 {
        match {
            a > 5 {
                #asm(gcc_x64) {
                    "{space}mov $1, %eax"
                    "{space}mov $1, %edi"
                    "{space}lea ${c}(%rip), %rsi"
                    "{space}mov $12, %edx"
                    "{space}syscall"
                }
            }
            | {
                #asm(gcc_x64) {
                    "{space}mov $1, %eax"
                    "{space}mov $1, %edi"
                    "{space}lea ${d}(%rip), %rsi"
                    "{space}mov $7, %edx"
                    "{space}syscall"
                }
            }
        }
        a = a - 1
    }
}

_start(): int {
    a: ""[int] = 30
    b::add_1(10)
    s: Name = Name {
        name: 10
    }
    add(s.name, a)
    add(a, 0)
    #asm(gcc_x64) {
        "{space}mov $60, %eax"
        "{space}mov $0, %edi"
        "syscall"
    }
    ret 0
}
