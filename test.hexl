#include io="library/os/io.hexl"


#define M(expr) {{
    expr = 10
    expr += 3
}}

struct Name {
    name: int
    aa: int

    f(self mut: Self) {
        self.name = 0
    }
}

variant E {
    a
    b(int)
    c
}

variant Option<T> {
    Some(T)
    None
}

variant Result<T, E> {
    Ok(T)
    Err(E)
}

f<T>(): T {
    e mut: E = E::b(10)
    cond E::b(val) mut:= e {
        val += 1
    } else {
        a: int = 10
    }
    lll: T = T {
        name: 10
        aa: 10
    }
    e = E::c
    ret lll
}


func4(): int must=func5 {
    ret 10
}

func5(a: int of func4): Result<int, byte> {
    name mut: int = 10
    #M(name)
    ret Result::Ok(a + 10)
}

func6(a: int must=func5) {
    func5(a)
}


add(a mut: int, b: int): Option<int> {
    c: byte* = "hello world\n"
    d: byte* = "tomato\n"

    loop a > 0 {
        cond {
            a > 5 => {
                io::print(c, 11)
            }
            else => {
                #asm(gcc_x64) {
                    "{space}movl $1, %eax"
                    "{space}movl $1, %edi"
                    "{space}leaq (${d}), %rsi"
                    "{space}movl $7, %edx"
                    "{space}syscall"
                }
                break
            }
        }
        a -= 1
    }
    ret Option::None
}

_start(): int {
    o: Option<int> = Option::Some(10)
    h: int must=func5 = func4()
    a: static[int] = 30
    ptr mut: int* = [a]
    ptr += 6
    s: Name* = Name {
        name: 10
        aa: 10
    }
    func6(h)
    add(s.name, a)
    add(a, 0)
    #asm(gcc_x64) {
        "{space}movl $60, %eax"
        "{space}movl $0, %edi"
        "syscall"
    }
    ll: Name = f<Name>()
    ret 0
}
