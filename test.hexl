#include std::io


add(a: int, b: int): int {
    c: char = "hello world\n"
    d: char = "tomato"
    loop a > 10 {
        match {
            a > 15 {
                #asm(gcc_x64) {
                    "{space}mov $1, %eax"
                    "{space}mov $1, %edi"
                    "{space}lea ${c}(%rip), %rsi"
                    "{space}mov $12, %edx"
                    "{space}syscall"
                }
            }
            | {
                #asm(gcc_x64) {
                    "{space}mov $1, %eax"
                    "{space}mov $1, %edi"
                    "{space}lea ${d}(%rip), %rsi"
                    "{space}mov $10, %edx"
                    "{space}syscall"
                }
            }
        }
        a = a - 1
    }
    ret b
}

main(): int {
    add(20, 1)
    #asm(gcc_x64) {
        "{space}mov $0, %eax"
        "{space}mov $60, %edi"
        "{space}syscall"
    }
}
