#include test::b
#include test::func::func2


struct Name {
    name: int
    aa: int
}


f<T>(): T {
    lll: T = T {
        name: 10
        aa: 10
    }
    ret lll
}


func4(): int must=func5 {
    ret 10
}

func5(a: int of func4): int {
    ret a + 10
}


add(a mut: int, b: int) {
    c: byte* = "hello world\n"
    d: byte* = "tomato\n"

    loop a > 0 {
        cond {
            a > 5 => {
                #asm(gcc_x64) {
                    "{space}movl $1, %eax"
                    "{space}movl $1, %edi"
                    "{space}leaq (${c}), %rsi"
                    "{space}movl $12, %edx"
                    "{space}syscall"
                }
            }
            | => {
                #asm(gcc_x64) {
                    "{space}movl $1, %eax"
                    "{space}movl $1, %edi"
                    "{space}leaq (${d}), %rsi"
                    "{space}movl $7, %edx"
                    "{space}syscall"
                }
            }
        }
        a = a - 1
    }
}

_start(): int {
    h: int must=func5 = func4()
    func2(10)
    a: static[int] = 30
    b::add_1(10)
    s: Name = Name {
        name: 10
        aa: 10
    }
    func5(h)
    add(s.name, a)
    add(a, 0)
    #asm(gcc_x64) {
        "{space}movl $60, %eax"
        "{space}movl $0, %edi"
        "syscall"
    }
    ll: Name = f<Name>()
    ret 0
}
