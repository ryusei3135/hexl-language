


add(a: b4, b: b4): b4 {
    loop a > 10 {
        b = b + 1
        a = a - 1
    }
    ret b
}

_start(a: a, b: b): b1 {
    c: b1 = "hello world"
    match {
        10 < 1 {
            add(15, 1)
        }
        | {
            add(3, 3)
        }
    }
    #x64 {
        "mov eax, 1"
        "mov edi, 1"
        "lea esi, ${c}"
        "mov edx, 10"
        "syscall"
    }
}
