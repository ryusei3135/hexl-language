
print(msg: byte*const, len: i64) {
    #asm(gcc_x64) {
        "mov $1, %rax"
        "mov $1, %rdi"
        "leaq ${msg}, %rsi"
        "mov ${len}, %rdx"
        "syscall"
    }
}


fizzbuzz(n: i64) {
    cond {
        n % 15 == 0 => {
            print("fb\n", 3)
        }
        n % 3 == 0 => {
            print("fz\n", 3)
        }
        n % 5 == 0 => {
            print("bz\n",3)
        }
        | => {
            print("n\n", 2)
        }
    }
}

_start() {
    i mut: i64 = 1
    loop i < 10 {
        fizzbuzz(i)
        i += 1
    }

    #asm(gcc_x64) {
        "mov $60, %rax"
        "mov $0, %rdi"
        "syscall"
    }
}
