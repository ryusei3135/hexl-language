{
  "reg": {
    "db": [
	"al", "cl", "dl", "bl"
    ],
    "dw": [
      "ax", "cx", "dx", "bx",
      "sp", "bp", "si", "di"
    ],
    "dd": [
	"eax", "ecx", "edx", "ebx",
    	"esp", "ebp", "esi", "edi",
    	"r8d", "r9d", "r10d", "r11d",
    	"r12d", "r13d", "r14d", "r15d"
    ],
    "dq": [
	"rax", "rcx", "rdx", "rbx",
    	"rsp", "rbp", "rsi", "rdi",
    	"r8", "r9", "r10", "r11",
    	"r12", "r13", "r14", "r15"
    ]
  },
  "args": {
	"fmt": {
		"linux": [7, 6, 2, 1, 8, 9],
	  	"win": [1, 2, 8, 9]
	}
  },
  "section": ".{name}\n",
  "fmt": {
	"reg": "%{}",
	"num": "${}",
    "static_var": "{name}(%rip)",
    "string": "{name}: .ascii \"{}\"\n",
    "global": ".global {name}\n"
  },
  "op": {
      "push": {"len": 1, "template": "{space}push {dst}\n"},
      "pop": {"len": 1, "template": "{space}pop {dst}\n"},
    "add": {
        "len": 2,
        "template": "{space}mov {src1}, {dst}\n{space}add {dst}, {src2}\n"
    },
    "sub": {
        "len": 2,
        "template": "{space}mov {src1}, {dst}\n{space}sub {dst}, {src2}\n"
    },
    "mul": {
        "len": 2,
        "template": "{space}mov {src1}, {dst}\n{space}mul {dst}, {src2}\n"
    },
    "div": {
        "len": 2,
        "template": "{space}mov {src1}, {dst}\n{space}div {dst}, {src2}\n"
    },
    "mov": {
        "len": 2,
        "template": "{space}mov {src1}, {dst}\n"
    },
    "cmp_l": {
        "len": 2,
        "template": "{space}mov {src1}, {dst}\n{space}cmp {dst}, {src2}\n{space}jl {label}\n"
    },
    "cmp_g": {
        "len": 2,
        "template": "{space}mov {src1}, {dst}\n{space}cmp {dst}, {src2}\n{space}jg {label}\n"
    },
    "ret": {
        "len": 1,
        "template": "{space}ret\n"
    }
  },
    "func": {
  	"ret": 0,
	"call": "call {name}\n"
  }
}
