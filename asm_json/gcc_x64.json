{
  "reg": {
    "db": [
	"al", "cl", "dl", "bl"
    ],
    "dw": [
      "ax", "cx", "dx", "bx",
      "sp", "bp", "si", "di"
    ],
    "dd": [
	"eax", "ecx", "edx", "ebx",
    	"esp", "ebp", "esi", "edi",
    	"r8d", "r9d", "r10d", "r11d",
    	"r12d", "r13d", "r14d", "r15d"
    ],
    "dq": [
	"rax", "rcx", "rdx", "rbx",
    	"rsp", "rbp", "rsi", "rdi",
    	"r8", "r9", "r10", "r11",
    	"r12", "r13", "r14", "r15"
    ]
  },
  "args": {
	"fmt": {
		"linux": [7, 6, 2, 1, 8, 9],
	  	"win": [1, 2, 8, 9]
	}
  },
  "section": ".{name}\n",
  "fmt": {
	"reg": "%{}",
	"num": "${}"
  },
  "op": {
    "add": {
	"len": 2,
	"template": "mov {src1}, {dst}\nadd {src2}, {dst}\n"
    },
    "sub": {
	"len": 2,
	"template": "mov {src1}, {dst}\nsub {src2}, {dst}\n"
    },
    "mul": {
	"len": 2,
	"template": "mov {src1}, {dst}\nmul {src2}, {dst}\n"
    },
    "div": {
	"len": 2,
	"template": "mov {src1}, {dst}\ndiv {src2}, {dst}\n"
    },
    "mov": {
	"len": 2,
	"template": "mov {src1}, {dst}\n"
    },
    "cmp_l": {
	    "len": 2,
	    "template": "mov {src1}, {dst}\ncmp {src2}, {dst}\njl {label}\n"
    },
    "cmp_g": {
	    "len": 2,
	    "template": "mov {src1}, {dst}\ncmp {src2}, {dst}\njg {label}\n"
    },
    "ret": {
	"len": 1,
	"template": "ret\n"
    }
  },
  "func": {
  	"ret": 0,
	"call": "call {name}\n"
  }
}
