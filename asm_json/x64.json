{
  "reg": {
    "db": [
	"al", "cl", "dl", "bl"
    ],
    "dw": [
      "ax", "cx", "dx", "bx",
      "sp", "bp", "si", "di"
    ],
    "dd": [
	"eax", "ecx", "edx", "ebx",
    	"esp", "ebp", "esi", "edi",
    	"r8d", "r9d", "r10d", "r11d",
    	"r12d", "r13d", "r14d", "r15d"
    ],
    "dq": [
	"rax", "rcx", "rdx", "rbx",
    	"rsp", "rbp", "rsi", "rdi",
    	"r8", "r9", "r10", "r11",
    	"r12", "r13", "r14", "r15"
    ]
  },
  "args": {
	  "linux": [7, 6, 2, 1, 8, 9],
	  "win": [1, 2, 8, 9]
  },
  "section": "section {name}\n",
  "fmt": {
	"reg": "{}",
	"num": "{}"
  },
  "op": {
    "add": {
	"len": 2,
	"template": "mov {dst}, {src1}\nadd {dst}, {src2}\n"
    },
    "sub": {
	"len": 2,
	"template": "mov {dst}, {src1}\nsub {dst}, {src2}\n"
    },
    "mul": {
	"len": 2,
	"template": "mov {dst}, {src1}\nmul {dst}, {src2}\n"
    },
    "div": {
	"len": 2,
	"template": "mov {dst}, {src1}\ndiv {dst}, {src2}\n"
    },
    "mov": {
	"len": 2,
	"template": "mov {dst}, {src}\n"
    },
    "cmp_l": {
	    "len": 2,
	    "template": "mov {dst}, {src1}\ncmp {dst}, {src2}\njl {label}\n"
    },
    "cmp_g": {
	    "len": 2,
	    "template": "mov {dst}, {src1}\ncmp {dst}, {src2}\njg {label}\n"
    },
    "ret": {
	"len": 1,
	"template": "ret\n"
    }
  },
  "func": {
  	"ret": 0
    "call": "call {name}"
  }
}
